{
  "name": "swerverts",
  "version": "0.1.0",
  "description": "Run the swerver gateway with TypeScript route handlers.",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "README.md"],
  "scripts": {
    "example": "bun run examples/hello.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["swerver", "gateway", "http", "proxy", "bun"],
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "optionalDependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
