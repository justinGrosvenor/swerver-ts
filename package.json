{
  "name": "swerverts",
  "version": "0.1.0",
  "description": "Run the swerver gateway with TypeScript route handlers.",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "README.md"],
  "scripts": {
    "example": "bun run examples/hello.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test && tsc --noEmit",
    "test:ffi": "bun test test/ffi.test.ts"
  },
  "keywords": ["swerver", "gateway", "http", "proxy", "bun"],
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "optionalDependencies": {
    "@swerver/darwin-arm64": "0.1.0-alpha.32",
    "@swerver/darwin-x64": "0.1.0-alpha.32",
    "@swerver/linux-arm64": "0.1.0-alpha.32",
    "@swerver/linux-x64": "0.1.0-alpha.32"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
